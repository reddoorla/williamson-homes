{
  "id": "page_hero",
  "type": "SharedSlice",
  "name": "PageHero",
  "description": "PageHero",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Full-width opening band: background photo or colour, the W mark, a headline and buttons",
      "imageUrl": "",
      "primary": {
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "heading",
            "placeholder": "",
            "allowTargetBlank": true,
            "single": "heading1"
          }
        },
        "background_image": {
          "type": "Image",
          "config": {
            "label": "background image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "background": {
          "type": "Select",
          "config": {
            "label": "background",
            "options": ["photo", "primary", "teal"],
            "default_value": "photo"
          }
        },
        "text_tone": {
          "type": "Select",
          "config": {
            "label": "text tone",
            "options": ["light", "dark"],
            "default_value": "light"
          }
        },
        "mark": {
          "type": "Select",
          "config": {
            "label": "mark",
            "options": ["w", "ocean-w", "none"],
            "default_value": "w"
          }
        },
        "ken_burns": {
          "type": "Boolean",
          "config": {
            "label": "slow zoom on the photo",
            "default_value": false,
            "placeholder_true": "yes",
            "placeholder_false": "no"
          }
        },
        "height": {
          "type": "Select",
          "config": {
            "label": "height (blank: tall with slow zoom, short without)",
            "options": ["tall", "short"]
          }
        },
        "top_space": {
          "type": "Select",
          "config": {
            "label": "top space (blank: 12rem, as home, contact and projects; 8rem as about)",
            "options": ["12rem", "8rem"]
          }
        },
        "bottom_space": {
          "type": "Select",
          "config": {
            "label": "bottom space (blank: 8rem, as home and about; 4rem as contact and projects)",
            "options": ["8rem", "4rem"]
          }
        },
        "image_position": {
          "type": "Select",
          "config": {
            "label": "photo position (blank: cover; bottom pins it to the bottom edge, full width, as about)",
            "options": ["cover", "bottom"]
          }
        },
        "layout": {
          "type": "Select",
          "config": {
            "label": "layout (blank: W mark first, as home and about; heading-first puts the heading above the mark, full width, as projects)",
            "options": ["mark-first", "heading-first"]
          }
        }
      },
      "items": {
        "button_label": {
          "type": "Text",
          "config": {
            "label": "button label",
            "placeholder": ""
          }
        },
        "button_link": {
          "type": "Link",
          "config": {
            "label": "button link",
            "placeholder": "",
            "allowTargetBlank": true,
            "select": null
          }
        }
      }
    }
  ]
}
