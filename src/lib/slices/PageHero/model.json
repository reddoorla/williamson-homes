{
  "id": "page_hero",
  "type": "SharedSlice",
  "name": "PageHero",
  "description": "PageHero",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Full-width opening band: background photo or colour, the W mark, a headline and buttons",
      "imageUrl": "",
      "primary": {
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "heading",
            "placeholder": "",
            "allowTargetBlank": true,
            "single": "heading1"
          }
        },
        "background_image": {
          "type": "Image",
          "config": {
            "label": "background image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "background": {
          "type": "Select",
          "config": {
            "label": "background",
            "options": ["photo", "primary", "teal"],
            "default_value": "photo"
          }
        },
        "text_tone": {
          "type": "Select",
          "config": {
            "label": "text tone",
            "options": ["light", "dark"],
            "default_value": "light"
          }
        },
        "mark": {
          "type": "Select",
          "config": {
            "label": "mark",
            "options": ["w", "ocean-w", "none"],
            "default_value": "w"
          }
        },
        "ken_burns": {
          "type": "Boolean",
          "config": {
            "label": "slow zoom on the photo",
            "default_value": false,
            "placeholder_true": "yes",
            "placeholder_false": "no"
          }
        },
        "height": {
          "type": "Select",
          "config": {
            "label": "height (blank: tall with slow zoom, short without)",
            "options": ["tall", "short"]
          }
        }
      },
      "items": {
        "button_label": {
          "type": "Text",
          "config": {
            "label": "button label",
            "placeholder": ""
          }
        },
        "button_link": {
          "type": "Link",
          "config": {
            "label": "button link",
            "placeholder": "",
            "allowTargetBlank": true,
            "select": null
          }
        }
      }
    }
  ]
}
