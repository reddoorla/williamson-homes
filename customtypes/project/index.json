{
  "id": "project",
  "label": "Project",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "title",
          "placeholder": "e.g. Palos Verdes Cove"
        }
      },
      "hero_image": {
        "type": "Image",
        "config": {
          "label": "hero image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "credits": {
        "type": "StructuredText",
        "config": {
          "label": "credits",
          "placeholder": "Photographer, interior designer",
          "allowTargetBlank": true,
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "gallery": {
        "type": "Group",
        "config": {
          "label": "gallery",
          "repeat": true,
          "fields": {
            "image": {
              "type": "Image",
              "config": {
                "label": "image",
                "constraint": {},
                "thumbnails": []
              }
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
